                  "pm.test('Trusted snapshots and identity',()=>{const o=pm.response.json().order;pm.expect(o.status).to.eql('pending');pm.expect(o.unitPriceCents).to.eql(2500);pm.expect(o.totalCents).to.eql(5000);pm.expect(o.buyerId).to.eql(pm.environment.get('buyerAId'));pm.expect(o.sellerId).to.eql(pm.environment.get('sellerAId'));pm.environment.set('orderSuccessId',o.id);});"
                ]
              }
            }
          ]
        },
